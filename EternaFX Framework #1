class Visualizer:
    """Visualizer for 3D projective space in EternaFX."""
    def __init__(self):
        self.fig = plt.figure(figsize=(6, 6))
        self.ax = self.fig.add_subplot(111, projection='3d')
        self.ax.set_xlabel('X-axis (Projective)') # More descriptive labels
        self.ax.set_ylabel('Y-axis (Projective)')
        self.ax.set_zlabel('Z-axis (Projective)')
        self.ax.set_title('EternaFX: 3D Projective Space Visualization')

    def plot_state(self, state_homogeneous):
        """Plots a state in 3D projective space."""
        state_3d = state_homogeneous[:3] / state_homogeneous[3]
        self.ax.scatter(state_3d[0], state_3d[1], state_3d[2], s=100, c='purple', alpha=0.7) # Customized scatter plot style
        plt.show()


# --- EternaFX Chatbot Interface Class ---
class EternaFXChatbotUI:
    def __init__(self, master, eterna_fx_instance):
        self.master = master
        master.title("EternaFX Chatbot Interface")
        self.efx = eterna_fx_instance # Instance of EternaFX engine

        # --- UI Elements ---
        self.chat_log = scrolledtext.ScrolledText(master, state='disabled', height=15, width=60)
        self.chat_log.grid(row=0, column=0, columnspan=3, padx=10, pady=10)

        # --- Shape Selection Dropdown ---
        self.shape_var = StringVar(master)
        self.shape_var.set("Hypersphere") # Default shape
        shape_options = ["Hypersphere", "Hypercube", "Zeta Function"]
        shape_menu = OptionMenu(master, self.shape_var, *shape_options, command=self.update_visualization_type)
        Label(master, text="Select Shape:").grid(row=1, column=0, padx=5, pady=5, sticky='e')
        shape_menu.grid(row=1, column=1, padx=5, pady=5, sticky='w')

        # --- Colormap Selection Dropdown ---
        self.colormap_var = StringVar(master)
        self.colormap_var.set("viridis") # Default colormap
        colormap_options = ["viridis", "plasma", "magma", "inferno", "cividis", "coolwarm", "spring"] # More options
        colormap_menu = OptionMenu(master, self.colormap_var, *colormap_options, command=self.update_colormap)
        Label(master, text="Select Colormap:").grid(row=2, column=0, padx=5, pady=5, sticky='e')
        colormap_menu.grid(row=2, column=1, padx=5, pady=5, sticky='w')

        # --- Prompt Entry ---
        self.prompt_entry = Entry(master, width=50)
        self.prompt_entry.grid(row=3, column=0, padx=10, pady=5, columnspan=2, sticky='ew')
        self.prompt_entry.bind("<Return>", self.send_prompt)

        # --- Send Button ---
        self.send_button = Button(master, text="Send", command=self.send_prompt)
        self.send_button.grid(row=3, column=2, padx=10, pady=5, sticky='w')

        # --- Prompt Dictionary Display (Scrollable Text) ---
        self.prompt_dict_display = scrolledtext.ScrolledText(master, state='disabled', height=8, width=60, bg='#f0f0f0') # Light gray background
        self.prompt_dict_display.grid(row=4, column=0, columnspan=3, padx=10, pady=5, sticky='nsew')
        self.display_prompt_dictionary() # Populate dictionary on startup

        # --- Status Bar ---
        self.status_bar = Label(master, text="Ready", bd=1, relief=tk.SUNKEN, anchor=tk.W)
        self.status_bar.grid(row=5, column=0, columnspan=3, sticky='ew')

    def update_visualization_type(self, selected_shape):
        """Updates the visualization based on the selected shape (for future use)."""
        self.display_message(f"EternaFX: Visualization shape set to: {selected_shape}")
        # In future: Implement logic to switch visualization type dynamically

    def update_colormap(self, selected_colormap):
        """Updates the colormap of the EternaFX visualizer."""
        self.display_message(f"EternaFX: Colormap set to: {selected_colormap}")
        self.efx.colormap = cm.get_cmap(selected_colormap) # Set colormap in EternaFX instance
        self.display_message("EternaFX: Redrawing visualization with new colormap (next animation).")


    def send_prompt(self, event=None):
        user_prompt = self.prompt_entry.get()
        self.prompt_entry.delete(0, tk.END)
        self.display_message(f"User: {user_prompt}")
        self.process_prompt(user_prompt)

    def display_message(self, message):
        self.chat_log.config(state=tk.NORMAL)
        self.chat_log.insert(tk.END, message + "\n")
        self.chat_log.config(state=tk.DISABLED)
        self.chat_log.see(tk.END)
        self.status_bar.config(text="Idle") # Reset status after message display

    def process_prompt(self, prompt):
        prompt_lower = prompt.lower()
        selected_shape = self.shape_var.get() # Get selected shape from dropdown
        selected_colormap = self.colormap_var.get() # Get selected colormap

        if "hypersphere" in prompt_lower or selected_shape == "Hypersphere": # Check dropdown or prompt
            self.display_message("EternaFX: Running hypersphere animation...")
            self.status_bar.config(text="Running Hypersphere...")
            points_4d_hypersphere = self.efx.generate_4d_hypersphere(num_points=300)
            hypersphere_animation_config = {
                'shape_type': 'hypersphere',
                'rotation_axes': 'xyz',
                'rotation_angles': [30, 45, 20],
                'rotation_speeds':,
                'scale_factor': 1.2,
                'camera_elevation': 35,
                'camera_azimuth': 45,
                'color_cycle_speed': 15,
                'colormap_name': selected_colormap # Pass selected colormap
            }
            self.efx.colormap = cm.get_cmap(selected_colormap) # Ensure colormap is set before running
            self.efx.run_animation(points_4d_hypersphere, hypersphere_animation_config, frames=250, interval=40, save_animation=False, filename='interactive_hypersphere.mp4')
            self.display_message("EternaFX: Hypersphere animation complete.")

        elif "hypercube" in prompt_lower or selected_shape == "Hypercube": # Check dropdown or prompt
            self.display_message("EternaFX: Running hypercube animation...")
            self.status_bar.config(text="Running Hypercube...")
            points_4d_hypercube = self.efx.generate_4d_hypercube(num_points_per_edge=15)
            hypercube_animation_config = {
                'shape_type': 'hypercube',
                'transformation_type_4d': 'shear_w',
                'rotation_axes': 'yz',
                'rotation_angles': [20, 30, 0],
                'rotation_speeds': [0.5, 0.7, 0],
                'scale_factor': 0.8,
                'camera_elevation': 25,
                'camera_azimuth': -30,
                'color_cycle_speed': 20,
                'colormap_name': selected_colormap # Pass selected colormap
            }
            self.efx.colormap = cm.get_cmap(selected_colormap) # Ensure colormap is set before running
            self.efx.run_animation(points_4d_hypercube, hypercube_animation_config, frames=300, interval=40, save_animation=False, filename='interactive_hypercube_shear.mp4')
            self.display_message("EternaFX: Hypercube animation complete.")

        elif "zeta" in prompt_lower or selected_shape == "Zeta Function": # Check dropdown or prompt
            self.display_message("EternaFX: Running Zeta Function visualization...")
            self.status_bar.config(text="Running Zeta Function...")
            zeta_points, critical_line_points = self.efx.generate_zeta_function_data(resolution=50)
            zeta_animation_config = {
                'camera_elevation': 45,
                'camera_azimuth': -60,
                'color_cycle_speed': 20,
                'colormap_name': selected_colormap # Pass selected colormap
            }
            self.efx.colormap = cm.get_cmap(selected_colormap) # Ensure colormap is set before running
            self.efx.run_zeta_animation(zeta_points, critical_line_points, zeta_animation_config, frames=200, interval=40, save_animation=False, filename='interactive_zeta_function.mp4')
            self.display_message("EternaFX: Zeta Function visualization complete.")


        elif "projective" in prompt_lower:
            self.display_message("EternaFX: Running Projective Framework Demo...")
            self.status_bar.config(text="Running Projective Demo...")
            # --- Projective Framework Demo Code (from previous response) ---
            pf = ProjectiveEternaFX()
            pf.state = np.array([1, 1, 1, 1])
            ada_ai = AdaLovelaceAI()
            pf.apply_transformation(ada_ai.projection_matrix)
            visualizer = Visualizer()
            visualizer.plot_state(pf.state)
            states = [np.array([1, 1, 1, 1]), np.array([2, 2, 2, 2]), np.array([3, 3, 3, 3]), np.array([4, 4, 4, 4])]
            transformed_states =
            for state in states:
                pf.state = state
                pf.apply_transformation(ada_ai.projection_matrix)
                transformed_states.append(pf.state)
            visualizer = Visualizer()
            for state in transformed_states:
                visualizer.plot_state(state)
            behavior =
            for i in range(len(states)):
                behavior.append(np.linalg.norm(states[i] - transformed_states[i]))
            plt.figure()
            plt.plot(behavior)
            plt.xlabel("State Index")
            plt.ylabel("Behavior (Norm of State Change)")
            plt.title("Behavior of Complex System under AI Transformation")
            plt.show()
            self.display_message("EternaFX: Projective Framework Demo Complete.")


        elif "help" in prompt_lower:
            self.display_message("EternaFX: Available commands: hypersphere, hypercube, zeta, projective, help")
            self.display_message("EternaFX: Use dropdown menus to select shape and colormap.")
            self.display_message("EternaFX: Type commands or select shapes from dropdown.")

        else:
            self.display_message("EternaFX: Command not recognized. Type 'help' for available commands.")
            self.status_bar.config(text="Command Not Recognized")


